# ============================================================
# diriddle API — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in production values.
# Never commit a .env file containing real secrets.
# ============================================================

# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (required in production)
DATABASE_URL=postgresql://diriddle:diriddle@localhost:5432/diriddle_dev

# In-memory mode: bypasses PostgreSQL for local dev / CI.
# Always set to false in production.
DEV_IN_MEMORY=false

# ─── JWT Authentication ─────────────────────────────────────
# Access token secret — must be at least 32 characters in production
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Refresh token secret — must differ from JWT_SECRET
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production

# Access token TTL (default: 15m)
JWT_EXPIRES_IN=15m

# Refresh token TTL (default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ────────────────────────────────────────────────────
# Dev bypass: when set to "true", accepts any 6-digit OTP in development.
# MUST be "false" or absent in production — enforced at boot.
ALLOW_DEV_OTP=true
DEV_OTP_BYPASS=

# ─── Location Privacy ───────────────────────────────────────
# How long (seconds) to retain temporary user GPS coordinates.
# Scheduler deletes them after this window.
# Default: 3600. MUST be explicitly set in production.
GPS_RETENTION_SECONDS=3600

# ─── Account Deletion ───────────────────────────────────────
# Recovery window (days) before an account deletion is irreversible.
# Default: 30.
ACCOUNT_DELETION_RECOVERY_DAYS=30

# ─── Background Scheduler ───────────────────────────────────
# Set to "false" to disable all cron jobs (e.g. in test workers).
ENABLE_SCHEDULER=true

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:8081,http://localhost:3001

# ─── File Uploads / Attachments ─────────────────────────────
# Cloud storage provider: "s3" | "gcs" | "local"
STORAGE_PROVIDER=local

# AWS S3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=diriddle-media-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage (alternative to S3)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILE=

# Local storage path (development only)
LOCAL_STORAGE_PATH=./uploads

# Max upload size in MB (default: 10)
MAX_UPLOAD_MB=10

# ─── Redis ──────────────────────────────────────────────────
# Used for Socket.IO multi-instance adapter and optional caching.
REDIS_URL=redis://localhost:6379

# ─── Supabase (optional — only if using Supabase Auth) ──────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ─── Push Notifications ─────────────────────────────────────
# Firebase Cloud Messaging (Android + Web)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Apple Push Notifications (iOS)
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=
APN_KEY_PATH=

# ─── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# ─── Apple Sign In ──────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# ─── SMS / OTP Gateway ──────────────────────────────────────
# Provider: "twilio" | "msg91" | "kaleyra" | "console"
# "console" logs OTPs to stdout — development only.
SMS_PROVIDER=console

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# ─── Email (Transactional) ──────────────────────────────────
# Provider: "sendgrid" | "ses" | "smtp" | "console"
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@diriddle.com
SENDGRID_API_KEY=

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Monitoring & Observability ─────────────────────────────
SENTRY_DSN=
# Log level: "verbose" | "debug" | "log" | "warn" | "error"
LOG_LEVEL=log

# ─── Admin Bootstrap ────────────────────────────────────────
# Phone or email of the first SUPER_ADMIN (seeded on first boot)
BOOTSTRAP_ADMIN_IDENTIFIER=
# ============================================================
