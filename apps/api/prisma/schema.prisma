generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
  PENDING_VERIFICATION
  DEACTIVATED
  DELETION_PENDING
}

enum CommunityType {
  CITY
  NEIGHBORHOOD
  CAMPUS
  SPECIAL
}

enum CommunityStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum MembershipStatus {
  ACTIVE
  LEFT
  BANNED
}

enum PostCategory {
  CONFESSION
  STORY
  QUESTION
  GOSSIP
  RANT
  CAMPUS
  NEIGHBORHOOD
  LOCAL_ALERT
  POLL
}

enum PostStatus {
  PUBLISHED
  DRAFT
  UNDER_REVIEW
  REMOVED
  EXPIRED
  HIDDEN
}

enum Visibility {
  COMMUNITY
  PUBLIC
  PRIVATE
  SELECTED_COMMUNITIES
}

enum CommentStatus {
  ACTIVE
  REMOVED
  FLAGGED
}

enum ReactionType {
  LIKE
  HEART
  LAUGH
  WOW
  SAD
  ANGRY
}

enum ReportReason {
  HARASSMENT
  SPAM
  DOXXING
  HATE_SPEECH
  MISINFORMATION
  IMPERSONATION
  NSFW
  OTHER
}

enum ReportStatus {
  RECEIVED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  APPROVE
  REMOVE
  RESTRICT
  WARN
  TEMPORARY_SUSPENSION
  PERMANENT_SUSPENSION
  ESCALATE
}

enum AppealStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum NotificationType {
  COMMENT_REPLY
  REACTION
  COMMUNITY_POST
  SYSTEM
}

enum AdminRoleType {
  SUPER_ADMIN
  TRUST_SAFETY_LEAD
  TRUST_SAFETY
  MODERATION_LEAD
  MODERATOR
  COMMUNITY_MANAGER
  ANALYST
}

// New enums

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  APPLE
}

enum DeletionRequestStatus {
  PENDING
  CANCELLED
  EXECUTED
}

enum AgeVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommunityRoleType {
  OWNER
  MODERATOR
  MEMBER
}

enum AttachmentType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AttachmentStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  FLAGGED
}

enum SearchType {
  POST
  COMMUNITY
  HASHTAG
  CITY
}

// ───────────────────────────────────────────────
// Existing models (unchanged structure, relations extended)
// ───────────────────────────────────────────────

model User {
  id          String     @id @default(uuid())
  authId      String     @unique @map("auth_id")
  status      UserStatus @default(ACTIVE)
  ageVerified Boolean    @default(false) @map("age_verified")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  anonymousIdentities AnonymousIdentity[]
  communityMembers    CommunityMember[]
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  commentReactions    CommentReaction[]
  savedPosts          SavedPost[]
  reportsFiled        Report[]                 @relation("ReporterRelation")
  blocksInitiated     Block[]                  @relation("BlockerRelation")
  blocksReceived      Block[]                  @relation("BlockedRelation")
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  notificationPrefs   NotificationPreference[]
  userConsents        UserConsent[]
  locationPreference  LocationPreference?
  idempotencyKeys     IdempotencyKey[]
  adminRole           AdminRole?
  auditLogs           AuditLog[]
  appeals             ModerationAppeal[]

  // New relations
  userProfile       UserProfile?
  authIdentities    AuthIdentity[]
  sessions          Session[]
  loginHistory      LoginHistory[]
  deletionRequest   DeletionRequest?
  ageVerification   AgeVerification?
  ownedCommunities  Community[]          @relation("CommunityOwner")
  communityBans     CommunityBan[]       @relation("BannedUser")
  bannedByActions   CommunityBan[]       @relation("BannedBy")
  joinRequests      JoinRequest[]        @relation("JoinRequester")
  reviewedJoins     JoinRequest[]        @relation("JoinReviewer")
  communityRoles    CommunityRole[]      @relation("CommunityRoleMember")
  grantedRoles      CommunityRole[]      @relation("CommunityRoleGranter")
  temporaryGps      TemporaryUserGps?
  searchHistory     SearchHistory[]

  @@map("users")
}

model AnonymousIdentity {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  communityId String?  @map("community_id")
  displayCode String   @map("display_code")
  avatarCode  String?  @map("avatar_code")
  isGlobal    Boolean  @default(false) @map("is_global")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])
  posts     Post[]
  comments  Comment[]

  // New relations
  identityHistory   IdentityHistory[]
  mentions          Mention[]
  identityAccessLog IdentityAccessLog[]

  @@unique([userId, communityId])
  @@unique([communityId, displayCode])
  @@map("anonymous_identities")
}

model Community {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  type        CommunityType
  city        String?
  state       String?
  geoCell     String?         @map("geo_cell")
  status      CommunityStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")

  // New fields
  ownerId     String?  @map("owner_id")
  description String?
  avatarUrl   String?  @map("avatar_url")
  coverUrl    String?  @map("cover_url")
  isPrivate   Boolean  @default(false) @map("is_private")
  maxMembers  Int?     @map("max_members")

  members             CommunityMember[]
  posts               Post[]
  anonymousIdentities AnonymousIdentity[]

  // New relations
  owner        User?           @relation("CommunityOwner", fields: [ownerId], references: [id])
  rules        CommunityRule[]
  bans         CommunityBan[]
  joinRequests JoinRequest[]
  roles        CommunityRole[]
  postAudience PostAudience[]

  @@index([city, status])
  @@map("communities")
}

model CommunityMember {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  communityId String           @map("community_id")
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at")

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
  @@map("community_members")
}

model Post {
  id                  String       @id @default(uuid())
  userId              String       @map("user_id")
  anonymousIdentityId String       @map("anonymous_identity_id")
  communityId         String       @map("community_id")
  category            PostCategory
  content             String
  status              PostStatus   @default(PUBLISHED)
  visibility          Visibility   @default(COMMUNITY)
  commentsEnabled     Boolean      @default(true) @map("comments_enabled")
  geoCell             String?      @map("geo_cell")
  expiresAt           DateTime?    @map("expires_at")
  isDraft             Boolean      @default(false) @map("is_draft")
  isPinned            Boolean      @default(false) @map("is_pinned")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  deletedAt           DateTime?    @map("deleted_at")

  user              User              @relation(fields: [userId], references: [id])
  anonymousIdentity AnonymousIdentity @relation(fields: [anonymousIdentityId], references: [id])
  community         Community         @relation(fields: [communityId], references: [id])
  comments          Comment[]
  reactions         Reaction[]
  savedPosts        SavedPost[]
  media             PostMedia[]
  poll              Poll?

  // New relations
  audience      PostAudience[]
  attachments   Attachment[]
  hashtags      PostHashtag[]
  mentions      Mention[]
  trendingScore TrendingScore?

  @@index([communityId, status, createdAt(sort: Desc)])
  @@index([category, status, createdAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@index([geoCell, status])
  @@map("posts")
}

model PostMedia {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  mediaType  String   @map("media_type")
  storageKey String   @map("storage_key")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id])

  @@map("post_media")
}

model Comment {
  id                  String        @id @default(uuid())
  postId              String        @map("post_id")
  userId              String        @map("user_id")
  anonymousIdentityId String        @map("anonymous_identity_id")
  parentCommentId     String?       @map("parent_comment_id")
  content             String
  status              CommentStatus @default(ACTIVE)
  createdAt           DateTime      @default(now()) @map("created_at")
  deletedAt           DateTime?     @map("deleted_at")

  post              Post              @relation(fields: [postId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  anonymousIdentity AnonymousIdentity @relation(fields: [anonymousIdentityId], references: [id])
  parentComment     Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies           Comment[]         @relation("CommentReplies")

  // New relations
  attachments Attachment[]
  mentions    Mention[]
  reactions   CommentReaction[]

  @@index([postId, status, createdAt])
  @@map("comments")
}

model Reaction {
  id           String       @id @default(uuid())
  postId       String       @map("post_id")
  userId       String       @map("user_id")
  reactionType ReactionType @map("reaction_type")
  createdAt    DateTime     @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@map("reactions")
}

model CommentReaction {
  id           String       @id @default(uuid())
  commentId    String       @map("comment_id")
  userId       String       @map("user_id")
  reactionType ReactionType @map("reaction_type")
  createdAt    DateTime     @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_reactions")
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@map("saved_posts")
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String       @map("reporter_id")
  targetType   String       @map("target_type")
  targetId     String       @map("target_id")
  reason       ReportReason
  description  String?
  status       ReportStatus @default(RECEIVED)
  priority     String       @default("NORMAL")
  createdAt    DateTime     @default(now()) @map("created_at")
  resolvedAt   DateTime?    @map("resolved_at")

  // New fields
  communityId  String?   @map("community_id")
  evidenceUrls String[]  @map("evidence_urls")

  reporter  User       @relation("ReporterRelation", fields: [reporterId], references: [id])

  @@index([status, priority, createdAt])
  @@map("reports")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockerRelation", fields: [blockerId], references: [id])
  blocked User @relation("BlockedRelation", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  referenceId String?          @map("reference_id")
  payload     Json             @default("{}")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String
  platform   String
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@map("device_tokens")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  notificationType String   @map("notification_type")
  pushEnabled      Boolean  @default(true) @map("push_enabled")
  inAppEnabled     Boolean  @default(true) @map("in_app_enabled")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, notificationType])
  @@map("notification_preferences")
}

model ModerationAction {
  id          String               @id @default(uuid())
  moderatorId String               @map("moderator_id")
  targetType  String               @map("target_type")
  targetId    String               @map("target_id")
  actionType  ModerationActionType @map("action_type")
  reason      String
  notes       String?
  createdAt   DateTime             @default(now()) @map("created_at")
  expiresAt   DateTime?            @map("expires_at")

  appeals ModerationAppeal[]

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

model ModerationAppeal {
  id                 String       @id @default(uuid())
  userId             String       @map("user_id")
  moderationActionId String       @map("moderation_action_id")
  reason             String
  status             AppealStatus @default(PENDING)
  reviewerId         String?      @map("reviewer_id")
  resolutionNotes    String?      @map("resolution_notes")
  createdAt          DateTime     @default(now()) @map("created_at")
  resolvedAt         DateTime?    @map("resolved_at")

  user             User             @relation(fields: [userId], references: [id])
  moderationAction ModerationAction @relation(fields: [moderationActionId], references: [id])

  @@index([status, createdAt])
  @@map("moderation_appeals")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model UserConsent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  consentType String   @map("consent_type")
  version     String
  granted     Boolean
  grantedAt   DateTime @default(now()) @map("granted_at")
  ipAddress   String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id])

  @@map("user_consents")
}

model LocationPreference {
  id                        String   @id @default(uuid())
  userId                    String   @unique @map("user_id")
  selectedCity              String?  @map("selected_city")
  selectedState             String?  @map("selected_state")
  geoCell                   String?  @map("geo_cell")
  locationPermissionGranted Boolean  @default(false) @map("location_permission_granted")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("location_preferences")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  key          String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@map("idempotency_keys")
}

model Poll {
  id        String   @id @default(uuid())
  postId    String   @unique @map("post_id")
  question  String
  closesAt  DateTime @map("closes_at")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post         @relation(fields: [postId], references: [id])
  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id         String @id @default(uuid())
  pollId     String @map("poll_id")
  optionText String @map("option_text")
  sortOrder  Int    @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id])
  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  id           String   @id @default(uuid())
  pollId       String   @map("poll_id")
  userId       String   @map("user_id")
  pollOptionId String   @map("poll_option_id")
  createdAt    DateTime @default(now()) @map("created_at")

  poll       Poll       @relation(fields: [pollId], references: [id])
  pollOption PollOption @relation(fields: [pollOptionId], references: [id])

  @@unique([pollId, userId])
  @@map("poll_votes")
}

model AdminRole {
  id        String        @id @default(uuid())
  userId    String        @unique @map("user_id")
  role      AdminRoleType
  scope     String?
  scopeId   String?       @map("scope_id")
  grantedAt DateTime      @default(now()) @map("granted_at")
  expiresAt DateTime?     @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("admin_roles")
}

// ───────────────────────────────────────────────
// NEW MODELS
// ───────────────────────────────────────────────

// Account & Auth

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  displayName       String?  @map("display_name")
  avatarUrl         String?  @map("avatar_url")
  interests         String[] @default([])
  ageBand           String?  @map("age_band")
  gender            String?
  preferredLanguage String?  @map("preferred_language")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  provider   AuthProvider
  identifier String
  verifiedAt DateTime?    @map("verified_at")
  isPrimary  Boolean      @default(false) @map("is_primary")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, identifier])
  @@map("auth_identities")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  jti          String    @unique
  deviceId     String?   @map("device_id")
  deviceName   String?   @map("device_name")
  platform     String?
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model LoginHistory {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  platform        String?
  approximateCity String?  @map("approximate_city")
  success         Boolean
  failReason      String?  @map("fail_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("login_history")
}

// Account Lifecycle

model DeletionRequest {
  id          String                @id @default(uuid())
  userId      String                @unique @map("user_id")
  requestedAt DateTime              @default(now()) @map("requested_at")
  scheduledAt DateTime?             @map("scheduled_at")
  cancelledAt DateTime?             @map("cancelled_at")
  executedAt  DateTime?             @map("executed_at")
  reason      String?
  status      DeletionRequestStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  @@map("deletion_requests")
}

// Age Verification

model AgeVerification {
  id               String                @id @default(uuid())
  userId           String                @unique @map("user_id")
  status           AgeVerificationStatus @default(PENDING)
  method           String?
  providerMetadata Json?                 @map("provider_metadata")
  verifiedAt       DateTime?             @map("verified_at")
  expiresAt        DateTime?             @map("expires_at")
  policyVersion    String?               @map("policy_version")
  createdAt        DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("age_verifications")
}

// Geography

model Country {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  states State[]

  @@map("countries")
}

model State {
  id        String   @id @default(uuid())
  countryId String   @map("country_id")
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@map("states")
}

model City {
  id          String    @id @default(uuid())
  stateId     String    @map("state_id")
  name        String
  slug        String    @unique
  aliases     String[]  @default([])
  centerLat   Float?    @map("center_lat")
  centerLng   Float?    @map("center_lng")
  radiusKm    Float?    @map("radius_km")
  isActive    Boolean   @default(false) @map("is_active")
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  state        State         @relation(fields: [stateId], references: [id])
  spatialCells SpatialCell[]

  @@index([isActive])
  @@map("cities")
}

model SpatialCell {
  id        String  @id @default(uuid())
  cityId    String  @map("city_id")
  cellCode  String  @unique @map("cell_code")
  level     Int
  centerLat Float?  @map("center_lat")
  centerLng Float?  @map("center_lng")
  radiusKm  Float?  @map("radius_km")

  city City @relation(fields: [cityId], references: [id])

  @@map("spatial_cells")
}

// GPS Privacy

model TemporaryUserGps {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  lat        Float
  lng        Float
  geoCell    String?  @map("geo_cell")
  capturedAt DateTime @default(now()) @map("captured_at")
  expiresAt  DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("temporary_user_gps")
}

// Community Enhancements

model CommunityRule {
  id          String    @id @default(uuid())
  communityId String    @map("community_id")
  title       String
  description String?
  orderIndex  Int       @default(0) @map("order_index")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  community Community @relation(fields: [communityId], references: [id])

  @@map("community_rules")
}

model CommunityBan {
  id          String    @id @default(uuid())
  communityId String    @map("community_id")
  userId      String    @map("user_id")
  reason      String?
  bannedById  String    @map("banned_by_id")
  bannedAt    DateTime  @default(now()) @map("banned_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  notes       String?

  community Community @relation(fields: [communityId], references: [id])
  user      User      @relation("BannedUser", fields: [userId], references: [id])
  bannedBy  User      @relation("BannedBy", fields: [bannedById], references: [id])

  @@map("community_bans")
}

model JoinRequest {
  id          String            @id @default(uuid())
  communityId String            @map("community_id")
  userId      String            @map("user_id")
  message     String?
  status      JoinRequestStatus @default(PENDING)
  reviewedById String?          @map("reviewed_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  community  Community @relation(fields: [communityId], references: [id])
  user       User      @relation("JoinRequester", fields: [userId], references: [id])
  reviewedBy User?     @relation("JoinReviewer", fields: [reviewedById], references: [id])

  @@unique([communityId, userId])
  @@map("join_requests")
}

model CommunityRole {
  id          String            @id @default(uuid())
  communityId String            @map("community_id")
  userId      String            @map("user_id")
  role        CommunityRoleType
  permissions String[]          @default([])
  grantedAt   DateTime          @default(now()) @map("granted_at")
  grantedById String            @map("granted_by_id")
  revokedAt   DateTime?         @map("revoked_at")

  community Community @relation(fields: [communityId], references: [id])
  user      User      @relation("CommunityRoleMember", fields: [userId], references: [id])
  grantedBy User      @relation("CommunityRoleGranter", fields: [grantedById], references: [id])

  @@unique([communityId, userId])
  @@map("community_roles")
}

// Anonymous Identity Enhancements

model IdentityHistory {
  id                  String   @id @default(uuid())
  identityId          String   @map("identity_id")
  previousDisplayCode String?  @map("previous_display_code")
  newDisplayCode      String?  @map("new_display_code")
  previousAvatarCode  String?  @map("previous_avatar_code")
  newAvatarCode       String?  @map("new_avatar_code")
  changedAt           DateTime @default(now()) @map("changed_at")
  changedBy           String?  @map("changed_by")
  reason              String?

  identity AnonymousIdentity @relation(fields: [identityId], references: [id])

  @@map("identity_history")
}

// Post Enhancements

model PostAudience {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  communityId String   @map("community_id")
  createdAt   DateTime @default(now()) @map("created_at")

  post      Post      @relation(fields: [postId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([postId, communityId])
  @@map("post_audiences")
}

model Attachment {
  id              String               @id @default(uuid())
  postId          String?              @map("post_id")
  commentId       String?              @map("comment_id")
  type            AttachmentType
  url             String
  thumbnailUrl    String?              @map("thumbnail_url")
  mimeType        String?              @map("mime_type")
  sizeBytes       Int?                 @map("size_bytes")
  durationSeconds Float?               @map("duration_seconds")
  status          AttachmentStatus     @default(PENDING)
  scanStatus      AttachmentScanStatus @default(PENDING) @map("scan_status")
  metadata        Json?
  createdAt       DateTime             @default(now()) @map("created_at")
  deletedAt       DateTime?            @map("deleted_at")

  post    Post?    @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

  @@map("attachments")
}

// Hashtags & Mentions

model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  postCount Int      @default(0) @map("post_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  id        String @id @default(uuid())
  postId    String @map("post_id")
  hashtagId String @map("hashtag_id")

  post    Post    @relation(fields: [postId], references: [id])
  hashtag Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([postId, hashtagId])
  @@map("post_hashtags")
}

model Mention {
  id                  String   @id @default(uuid())
  postId              String?  @map("post_id")
  commentId           String?  @map("comment_id")
  mentionedIdentityId String   @map("mentioned_identity_id")
  createdAt           DateTime @default(now()) @map("created_at")

  post              Post?             @relation(fields: [postId], references: [id])
  comment           Comment?          @relation(fields: [commentId], references: [id])
  mentionedIdentity AnonymousIdentity @relation(fields: [mentionedIdentityId], references: [id])

  @@map("mentions")
}

// Feed & Trending

model TrendingScore {
  id          String   @id @default(uuid())
  postId      String   @unique @map("post_id")
  citySlug    String   @map("city_slug")
  communityId String?  @map("community_id")
  score       Float    @default(0)
  viewCount   Int      @default(0) @map("view_count")
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  updatedAt   DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id])

  @@index([citySlug, score(sort: Desc)])
  @@index([communityId, score(sort: Desc)])
  @@map("trending_scores")
}

model SearchHistory {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  query      String
  searchType SearchType @map("search_type")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("search_history")
}

// Identity Access Log

model IdentityAccessLog {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  identityId    String   @map("identity_id")
  accessReason  String?  @map("access_reason")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  identity AnonymousIdentity @relation(fields: [identityId], references: [id])

  @@map("identity_access_logs")
}

// Retention Policy

model RetentionPolicy {
  id            String   @id @default(uuid())
  dataType      String   @map("data_type")
  retentionDays Int?     @map("retention_days")
  legalBasis    String?  @map("legal_basis")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("retention_policies")
}


// OTP Persistent Storage

model OtpChallenge {
  id               String    @id @default(uuid())
  identifier       String
  hashedCode       String    @map("hashed_code")
  expiresAt        DateTime  @map("expires_at")
  attempts         Int       @default(0)
  dailyCount       Int       @default(1) @map("daily_count")
  dailyWindowStart DateTime  @default(now()) @map("daily_window_start")
  lastSentAt       DateTime  @default(now()) @map("last_sent_at")
  usedAt           DateTime? @map("used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([identifier, expiresAt])
  @@map("otp_challenges")
}
