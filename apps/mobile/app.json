{
  "expo": {
    "name": "diriddle",
    "slug": "diriddle",
    "version": "0.1.0",
    "scheme": "diriddle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090B0F"
    },
    "backgroundColor": "#090B0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.diriddle.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "diriddle uses your approximate location to show local anonymous conversations in your city.",
        "NSPhotoLibraryUsageDescription": "diriddle allows you to attach photos to your anonymous posts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090B0F"
      },
      "package": "in.diriddle.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
