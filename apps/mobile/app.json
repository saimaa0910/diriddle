{
  "expo": {
    "name": "diriddle",
    "slug": "diriddle",
    "version": "0.1.0",
    "scheme": "diriddle",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090B0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.diriddle.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090B0F"
      },
      "package": "in.diriddle.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": ""
    },
    "plugins": [
      "expo-router"
    ]
  }
}
