{
  "name": "@diriddle/admin",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "node --test src/__tests__/*.test.mjs",
    "desktop": "electron electron/main.js",
    "desktop:dev": "node electron/run-dev.js",
    "desktop:start": "electron electron/main.js",
    "desktop:dist": "next build && electron-builder --win",
    "desktop:pack": "next build && electron-builder --win --dir"
  },
  "build": {
    "appId": "in.diriddle.admin",
    "productName": "diriddle-admin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@diriddle/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0"
  }
}
